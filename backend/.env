# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# Full DSN for pgx connection pool.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sakai?sslmode=disable

# Path to the migrations/ directory. Adjust if running the binary from a
# different working directory (e.g. in Docker: /app/migrations).
MIGRATIONS_DIR=../migrations

# ─── JWT ──────────────────────────────────────────────────────────────────────
# MUST be overridden in production with a cryptographically random value.
# Minimum 32 characters recommended.
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Duration strings use Go's time.ParseDuration format: e.g. 15m, 1h, 24h, 168h
ACCESS_TOKEN_EXPIRY=60m
REFRESH_TOKEN_EXPIRY=720h   # 30 days

# ─── WebSocket ────────────────────────────────────────────────────────────────
# How often the server sends a ping frame to connected clients.
WS_PING_INTERVAL=30s

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max location update events per minute per driver connection.
LOCATION_RATE_LIMIT_PER_MIN=30
