# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# Full DSN for pgx connection pool.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
# Use the DIRECT connection (db.<ref>.supabase.co:5432), NOT the pooler URL.
DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=disable

# Path to the migrations/ directory. Not used at runtime (migrations are
# embedded in the binary), but kept for tooling / local reference.
MIGRATIONS_DIR=../migrations

# ─── Redis ────────────────────────────────────────────────────────────────────
# Required — used for WebSocket pub/sub and event replay.
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# MUST be overridden in production with a cryptographically random value.
# Minimum 32 characters recommended.
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Duration strings use Go's time.ParseDuration format: e.g. 15m, 1h, 24h, 168h
ACCESS_TOKEN_EXPIRY=60m
REFRESH_TOKEN_EXPIRY=720h   # 30 days

# ─── WebSocket ────────────────────────────────────────────────────────────────
# How often the server sends a ping frame to connected clients.
WS_PING_INTERVAL=30s

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max location update events per minute per driver connection.
LOCATION_RATE_LIMIT_PER_MIN=30

# ─── Stripe (Payments) ────────────────────────────────────────────────────────
# Secret key — NEVER commit to source control. Use test keys in development.
STRIPE_SECRET_KEY=sk_test_...
# Publishable key — safe to expose in mobile app.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Storage (Driver Documents) ───────────────────────────────────────────────
# Set STORAGE_PROVIDER=s3 for any S3-compatible provider (Supabase Storage,
# Cloudflare R2, AWS S3). Leave as "local" for local dev only.
STORAGE_PROVIDER=local

# Local storage (dev only — not usable in read-only container filesystems)
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=/api/files

# S3-compatible storage — required when STORAGE_PROVIDER=s3
#
# Supabase Storage:
#   STORAGE_ENDPOINT    → Project Settings → Storage → S3 endpoint
#   STORAGE_REGION      → your Supabase project region (e.g. ap-southeast-1)
#   STORAGE_ACCESS_KEY  → Project Settings → Storage → S3 Access Keys
#   STORAGE_SECRET_KEY  → Project Settings → Storage → S3 Access Keys
#   STORAGE_BUCKET      → bucket name you created in Supabase Storage
#   STORAGE_PUBLIC_BASE_URL → https://<ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=driver-documents
STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/driver-documents

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Empty = no browser clients.
# ALLOWED_ORIGINS=https://your-frontend.com,https://admin.your-app.com
